<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cheatly.Avalonia.OverlayWindow"
        Title="Cheatly"
        Width="320"
        Height="400"
        MinWidth="280"
        MinHeight="200"
        CanResize="True"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SystemDecorations="BorderOnly"
        Background="#1E1E1E"
        TransparencyLevelHint="AcrylicBlur">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="8">
        <!-- Drag handle / header -->
        <Border Grid.Row="0" 
                Background="#2D2D2D" 
                CornerRadius="4" 
                Padding="8,4"
                Cursor="Hand"
                PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <!-- Connection indicator -->
                <Ellipse Name="ConnectionIndicator"
                         Width="8" Height="8"
                         Fill="#4CAF50"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Cheatly" 
                           FontWeight="SemiBold" 
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"/>
                <TextBlock Name="ModeIndicator" 
                           Grid.Column="2"
                           Text="Ready" 
                           Foreground="#888888"
                           FontSize="11"
                           Margin="8,0"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="3" 
                    Content="Back"
                    MinWidth="42"
                    Height="24"
                    Margin="8,0,0,0"
                    Background="#3A3A3A"
                    Foreground="#CCCCCC"
                    Click="OnBackClicked"/>
                <Button Grid.Column="4" 
                        Content="X" 
                        Width="24" 
                        Height="24"
                    Margin="6,0,0,0"
                        Background="Transparent"
                        Foreground="#888888"
                        Click="OnCloseClicked"/>
            </Grid>
        </Border>

        <!-- Live Transcript -->
        <Border Grid.Row="1" 
                Background="#252525" 
                CornerRadius="4" 
                Margin="0,8,0,0"
                Padding="8">
            <ScrollViewer Name="TranscriptScroller" VerticalScrollBarVisibility="Auto">
                <TextBlock Name="TranscriptText" 
                           Text="{Binding Transcript, FallbackValue='Listening...'}" 
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </ScrollViewer>
        </Border>

        <!-- Suggestions -->
        <Border Grid.Row="2" 
                Background="#2A2A2A" 
                CornerRadius="4" 
                Margin="0,8,0,0"
                Padding="8"
                MaxHeight="200">
            <ScrollViewer Name="SuggestionsScroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="SuggestionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                       Foreground="#DDDDDD"
                                       TextWrapping="Wrap"
                                       Margin="0,2"
                                       FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Text Input -->
        <TextBox Name="UserInputBox" 
                 Grid.Row="3"
                 Text="{Binding InputText, Mode=TwoWay}"
                 Watermark="Add context or corrections..."
                 Background="#333333"
                 Foreground="#FFFFFF"
                 Margin="0,8,0,0"
                 Height="32"
                 CornerRadius="4"/>

        <!-- Send Button -->
        <Button Grid.Row="4" 
                Content="Send" 
                HorizontalAlignment="Stretch"
                Margin="0,8,0,0"
                Background="#0078D4"
                Foreground="White"
                CornerRadius="4"
                Click="OnSendClicked"/>
    </Grid>
</Window>
