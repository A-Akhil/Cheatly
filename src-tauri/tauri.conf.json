{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cheatly",
  "version": "0.1.0",
  "identifier": "com.cheatly.app",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cheatly Overlay",
        "width": 500,
        "height": 700,
        "x": 24,
        "y": 24,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
